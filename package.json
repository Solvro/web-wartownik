{
  "name": "wartownik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=web",
    "db:generate": "pnpm --filter @wartownik/db db:generate",
    "db:migrate": "pnpm --filter @wartownik/db db:migrate",
    "db:seed": "pnpm --filter @wartownik/db db:seed",
    "db:studio": "pnpm --filter @wartownik/db db:studio",
    "db:sync-shelters": "pnpm --filter @wartownik/api sync-shelters",
    "dev": "turbo run dev --filter=web --filter=@wartownik/mobile",
    "dev:web": "turbo run dev --filter=web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prepare": "husky || true",
    "start": "pnpm --filter web start",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*": "prettier -w --ignore-unknown"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.11"
  }
}
